      {"op": "insert",
       "table": "ordinals",
       "row": {"number": 0, "name": "zero"}}]]]],
  [[row,action,name,number,_version
<0>,initial,"""ten""",10,"[""uuid"",""<1>""]"

row,action,name,number,_version
<2>,insert,"""zero""",0,"[""uuid"",""<3>""]"
]])

