       "row": {"number": 10, "name": "ten"}},
      {"op": "insert",
       "table": "ordinals",
       "row": {"number": 11, "name": "eleven"}}]]]], ['txn' ]); do
  AT_CHECK([ovsdb-client transact unix:socket "$txn"], [0],
